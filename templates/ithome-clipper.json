{
	"schemaVersion": "0.1.0",
	"name": "ithome",
	"behavior": "create",
	"noteContentFormat": "# {{title}}\n{{selectorHtml:article|first|remove_html:(\"ul,.ad-content\")|markdown}}\n\n# 資料來源\n{{selectorHtml:span.created|markdown}}: [{{title}}]({{url}}) ",
	"properties": [
		{
			"name": "新聞來源",
			"value": "{{meta:property:og:site_name}}",
			"type": "text"
		},
		{
			"name": "published",
			"value": "{{selectorHtml:span.created|markdown}}",
			"type": "date"
		}
	],
	"triggers": [
		"https://www.inside.com.tw/",
		"https://www.ithome.com.tw/"
	],
	"noteNameFormat": "{{title}}",
	"path": "0 Fleet Note"
}